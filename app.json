{
  "expo": {
    "name": "MSpace",
    "slug": "mspace-app",
    "scheme": "mspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0B"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      },
      "package": "com.lightants.mspace"
    },
    "plugins": [
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
